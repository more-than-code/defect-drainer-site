{
  "name": "defect-drainer-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 8898",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --port 8898 --strictPort",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --test 'tests/*.test.mjs'"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "26.6.5",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22"
  }
}
